# ========================================================
# SiftX Production Environment Variables Template (.env.example)
# Add these variables to your Vercel Project Settings > Environment Variables
# NEVER commit your real secrets to Git.
# ========================================================

# 1. Google Gemini API (For Gemini Live Neural TTS: Aoede, Charon, Puck, Fenrir, Kore)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq Cloud API (For ultra-fast Whisper Large V3 Turbo Speech-to-Text)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3. Fish Audio API (Optional: for specialized Fish Audio voices)
# Obtain from: https://fish.audio/app/developers/api-keys
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# 4. Optional Server Port (for local Node server: npm start)
PORT=3000
